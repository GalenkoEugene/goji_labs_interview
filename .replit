modules = ["ruby-3.2", "bash", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["libyaml", "libffi", "zlib", "openssl", "ruby", "bundler", "gcc", "gnumake", "pkg-config"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Rails Server"

[[workflows.workflow]]
name = "Rails Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bundle exec rails server"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bundle", "exec", "rails", "server"]
